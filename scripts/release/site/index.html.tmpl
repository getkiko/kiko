<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kiko · 看得清每一条连接的代理客户端</title>
<meta name="description" content="Kiko：基于 sing-box 的 macOS、Windows 代理客户端与 Linux 服务器。分流规则、连接监控、策略组测速、HTTPS 解密与远程管理。">
<link rel="icon" type="image/png" sizes="64x64" href="favicon.png">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<style>
:root {
  --bg: #fbfbfd; --surface: #fff; --text: #1d1d1f; --muted: #6e6e73; --line: #e3e3e8;
  --soft: #f2f2f5; --code-bg: #f2f2f5; --btn: #1d1d1f; --btn-text: #fff;
  --link: #0066cc;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0b0b0d; --surface: #161618; --text: #f5f5f7; --muted: #a1a1a6; --line: #2a2a2e;
    --soft: #1c1c1f; --code-bg: #1f1f23; --btn: #f5f5f7; --btn-text: #111;
    --link: #2997ff;
  }
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0; background: var(--bg); color: var(--text);
  font: 16px/1.6 -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased; text-wrap: pretty;
}
a { color: var(--link); text-decoration: none; }
a:hover { text-decoration: underline; }
.wrap { max-width: 1080px; margin: 0 auto; padding: 0 24px; }

/* Navigation */
nav { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 78%, transparent);
  backdrop-filter: saturate(180%) blur(20px); -webkit-backdrop-filter: saturate(180%) blur(20px); border-bottom: 1px solid var(--line); }
nav .wrap { display: flex; align-items: center; gap: 28px; height: 56px; }
.brand { display: flex; align-items: center; gap: 10px; color: var(--text); font-weight: 650; font-size: 17px; }
.brand:hover { text-decoration: none; }
nav .links { display: flex; gap: 24px; margin-left: auto; font-size: 14px; }
nav .links a { color: var(--muted); }
nav .links a:hover { color: var(--text); text-decoration: none; }

/* Hero */
.hero { position: relative; text-align: center; padding: 88px 0 40px; overflow: hidden; }
.hero h1 { font-size: clamp(44px, 7vw, 72px); line-height: 1.05; letter-spacing: -0.03em; margin: 0; font-weight: 700; }
.hero .name { font-size: 17px; font-weight: 600; color: var(--muted); margin: 0 0 14px; }
.hero .lead { font-size: clamp(19px, 2.4vw, 24px); color: var(--muted); margin: 14px auto 0; max-width: 640px; line-height: 1.45; }
.cta { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
.btn { display: inline-flex; align-items: center; gap: 10px; padding: 13px 24px; border-radius: 999px; font-size: 16px; font-weight: 600;
  background: var(--btn); color: var(--btn-text); transition: opacity .15s ease; }
.btn:hover { text-decoration: none; opacity: .88; }
.btn[hidden] { display: none; }
.btn.alt { background: var(--soft); color: var(--text); }
.btn small { font-weight: 400; opacity: .7; font-size: 13px; }
.btn svg { width: 18px; height: 18px; flex: none; }
.meta { margin-top: 18px; color: var(--muted); font-size: 14px; }
.meta a { color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }

/* Screenshot */
.shot { margin: 56px auto 0; max-width: 1000px; border-radius: 14px; overflow: hidden; background: var(--surface);
  box-shadow: 0 0 0 1px var(--line), 0 30px 70px -24px rgba(0, 0, 0, .28); }
.shot .bar { display: flex; gap: 8px; padding: 12px 14px; background: var(--soft); border-bottom: 1px solid var(--line); }
.shot .bar i { width: 12px; height: 12px; border-radius: 50%; background: #ff5f57; }
.shot .bar i:nth-child(2) { background: #febc2e; } .shot .bar i:nth-child(3) { background: #28c840; }
.shot img { display: block; width: 100%; height: auto; }

/* Sections */
section.block { padding: 96px 0 0; }
.kicker { text-align: center; color: var(--muted); font-weight: 600; font-size: 15px; margin: 0; }
h2 { text-align: center; font-size: clamp(30px, 4.4vw, 44px); letter-spacing: -0.02em; line-height: 1.15; margin: 8px 0 0; }
.sub { text-align: center; color: var(--muted); font-size: 18px; margin: 12px auto 0; max-width: 620px; }

.features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 48px; }
.feature { padding: 26px; background: var(--surface); border: 1px solid var(--line); border-radius: 18px; }
.feature .ic { color: var(--text); }
.feature .ic svg { width: 24px; height: 24px; display: block; }
.feature h3 { font-size: 18px; margin: 14px 0 6px; }
.feature p { margin: 0; color: var(--muted); font-size: 15px; }

/* Downloads */
.downloads { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 48px; align-items: start; }
.card { padding: 28px; background: var(--surface); border: 1px solid var(--line); border-radius: 20px; min-width: 0; }
.card.current { border-color: var(--text); }
.card .os { display: flex; align-items: center; gap: 10px; font-size: 20px; font-weight: 650; }
.card .os svg { width: 22px; height: 22px; }
.card .req { color: var(--muted); font-size: 14px; margin: 4px 0 18px; }
.card .btns { display: grid; gap: 10px; }
.card .btn { justify-content: space-between; border-radius: 12px; padding: 12px 16px; font-size: 15px; }
.card p { font-size: 14px; color: var(--muted); margin: 14px 0 0; }
.card details { margin-top: 16px; border-top: 1px solid var(--line); padding-top: 12px; }
details summary { cursor: pointer; font-size: 14px; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
details summary::-webkit-details-marker { display: none; }
details summary::after { content: "+"; color: var(--muted); font-weight: 400; }
details[open] summary::after { content: "−"; }
details h4 { font-size: 13px; margin: 14px 0 4px; color: var(--muted); font-weight: 600; }
.card details p { margin: 6px 0 0; }
.cmd { display: flex; align-items: stretch; margin: 6px 0 0; background: var(--code-bg); border-radius: 10px; overflow: hidden; text-align: left; }
.cmd code { flex: 1; min-width: 0; padding: 9px 12px; overflow-x: auto; white-space: pre; font: 12.5px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
.cmd button { flex: none; border: 0; border-left: 1px solid var(--line); background: transparent; color: var(--link); padding: 0 12px; font: inherit; font-size: 12.5px; cursor: pointer; }
.cmd button:hover { background: var(--soft); }
code.inline { padding: 1px 6px; border-radius: 6px; background: var(--code-bg); font: 12.5px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }

/* FAQ */
.faq { max-width: 760px; margin: 40px auto 0; border-top: 1px solid var(--line); }
.faq details { padding: 18px 0; border-bottom: 1px solid var(--line); }
.faq details summary { font-size: 17px; }
.faq details p, .faq dd { color: var(--muted); font-size: 15px; margin: 10px 0 0; }
.faq dl { margin: 6px 0 0; } .faq dt { font-weight: 600; margin-top: 12px; font-size: 14px; } .faq dd { margin-top: 2px; }

footer { margin-top: 110px; padding: 28px 0 40px; border-top: 1px solid var(--line); color: var(--muted); font-size: 14px; }
footer .wrap { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: center; }
footer .brand { font-size: 15px; }
footer .links { display: flex; gap: 20px; margin-left: auto; }
footer a { color: var(--muted); }

@media (max-width: 880px) {
  .features, .downloads { grid-template-columns: 1fr; }
  nav .links a.hide-s { display: none; }
  .hero { padding-top: 56px; }
  section.block { padding-top: 72px; }
}
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .btn { transition: none; } }
</style>
</head>
<body>
<nav>
  <div class="wrap">
    <a class="brand" href="#">Kiko</a>
    <div class="links">
      <a class="hide-s" href="#features">功能</a>
      <a href="#download">下载</a>
      <a class="hide-s" href="#faq">常见问题</a>
      <a href="https://github.com/{{.Repo}}">GitHub</a>
    </div>
  </div>
</nav>

<header class="hero">
  <div class="wrap">
    <p class="name">Kiko</p>
    <h1>看清每一条连接</h1>
    <p class="lead">Kiko 是基于 sing-box 的代理客户端。分流、测速、监控与远程管理，都在一个原生应用里。</p>
    <div class="cta" id="cta">
      <a class="btn" href="{{.DMG "arm64"}}" data-os="mac">{{template "apple"}}下载 macOS 版 <small>Apple 芯片</small></a>
      <a class="btn alt" href="{{.DMG "amd64"}}" data-os="mac">Intel 芯片</a>
      <a class="btn" href="{{.Installer "amd64"}}" data-os="win" hidden>{{template "windows"}}下载 Windows 版 <small>x64</small></a>
      <a class="btn alt" href="{{.Installer "arm64"}}" data-os="win" hidden>ARM64</a>
      <a class="btn" href="#download" data-os="linux" hidden>{{template "server"}}安装到 Linux 服务器</a>
    </div>
    <p class="meta">v{{.Version}} · 免费开源 · macOS 12+ / Windows 10+ / Linux 服务器 · <a href="#download">全部平台</a></p>
    <div class="shot">
      <div class="bar"><i></i><i></i><i></i></div>
      <picture>
        <source srcset="screenshot-dark.png" media="(prefers-color-scheme: dark)">
        <img src="screenshot-light.png" width="2480" height="1280" alt="Kiko 概览：内核状态、出站模式、实时网速与策略组">
      </picture>
    </div>
  </div>
</header>

<main>
<section class="block" id="features">
  <div class="wrap">
    <p class="kicker">功能</p>
    <h2>代理该有的，都做到位</h2>
    <p class="sub">原生绘制的界面，不套网页；大多数改动无需重启内核即可生效。</p>
    <div class="features">
      <div class="feature"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="12" cy="19" r="2.5"/><path d="M6 8.5v2a3 3 0 0 0 3 3h6a3 3 0 0 0 3-3v-2M12 13.5v3"/></svg></div>
        <h3>分流规则</h3><p>按设备、域名和规则集分流，拓扑图实时显示哪条规则正在承载流量。</p></div>
      <div class="feature"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg></div>
        <h3>连接一目了然</h3><p>每条连接的进程、规则、出口与速率；DNS 查询和被拒绝的连接也都有记录。</p></div>
      <div class="feature"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 13l4-3M12 2v3"/></svg></div>
        <h3>策略组与测速</h3><p>手动、最快、故障转移、负载均衡；并行测速，在菜单栏就能切换节点。</p></div>
      <div class="feature"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></div>
        <h3>HTTPS 解密与改写</h3><p>按需解密指定域名，抓包、重放、导出 HAR；支持 URL、请求头与脚本改写。</p></div>
      <div class="feature"><div class="ic">{{template "server"}}</div>
        <h3>远程管理服务器</h3><p>在家里的网关或 VPS 上运行 kiko-server，用同一个应用通过 TLS 配对管理。</p></div>
      <div class="feature"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg></div>
        <h3>用量与进程</h3><p>按分钟记录的流量历史，按应用统计流量、CPU 与内存，可导出 CSV。</p></div>
    </div>
  </div>
</section>

<section class="block" id="download">
  <div class="wrap">
    <p class="kicker">下载</p>
    <h2>选择你的平台</h2>
    <p class="sub">桌面应用每天自动检查更新，只安装用发布密钥签名的版本。</p>
    <div class="downloads">
      <div class="card" data-card="mac">
        <div class="os">{{template "apple"}}macOS</div>
        <div class="req">macOS 12 或更新</div>
        <div class="btns">
          <a class="btn" href="{{.DMG "arm64"}}">Apple 芯片 <small>.dmg</small></a>
          <a class="btn alt" href="{{.DMG "amd64"}}">Intel 芯片 <small>.dmg</small></a>
        </div>
        <p>打开 .dmg，把 Kiko 拖进「应用程序」。不确定芯片：苹果菜单 →「关于本机」。</p>
        <details>
          <summary>首次打开与卸载</summary>
          <h4>首次打开</h4>
          <p>提示无法验证开发者时，到「系统设置 → 隐私与安全性」点「仍要打开」。如果提示“已损坏”，在“终端”中运行：</p>
          <div class="cmd"><code>xattr -dr com.apple.quarantine /Applications/Kiko.app</code><button type="button">复制</button></div>
          <p>首次开启 TUN 时会请求管理员密码，安装网络特权组件。</p>
          <h4>卸载</h4>
          <p>把 Kiko 拖到废纸篓。要一并移除特权组件和配置：</p>
          <div class="cmd"><code>curl -fsSL {{.Latest}}/install.sh | sh -s -- --uninstall</code><button type="button">复制</button></div>
        </details>
      </div>

      <div class="card" data-card="win">
        <div class="os">{{template "windows"}}Windows</div>
        <div class="req">Windows 10 或更新</div>
        <div class="btns">
          <a class="btn" href="{{.Installer "amd64"}}">x64 安装程序 <small>.exe</small></a>
          <a class="btn alt" href="{{.Installer "arm64"}}">ARM64 安装程序 <small>.exe</small></a>
        </div>
        <p>首次运行时若提示“Windows 已保护你的电脑”，点「更多信息 → 仍要运行」。</p>
        <details>
          <summary>用 PowerShell 安装与卸载</summary>
          <h4>安装</h4>
          <p>无需管理员权限，自动选择架构：</p>
          <div class="cmd"><code>irm {{.Latest}}/install.ps1 | iex</code><button type="button">复制</button></div>
          <h4>卸载</h4>
          <p>在「设置 → 应用 → 已安装的应用」中卸载 Kiko。</p>
        </details>
      </div>

      <div class="card" data-card="linux">
        <div class="os">{{template "server"}}Linux 服务器</div>
        <div class="req">x86_64 / ARM64 · systemd</div>
        <p style="margin-top:0">在服务器上运行，安装为服务并开机自启：</p>
        <div class="cmd"><code>curl -fsSL {{.Latest}}/install-server.sh | sudo sh</code><button type="button">复制</button></div>
        <p>再运行下面的命令，在 Kiko 中选择「服务器 → 连接到服务器…」，粘贴输出的配对字符串：</p>
        <div class="cmd"><code>sudo kiko pair</code><button type="button">复制</button></div>
        <details>
          <summary>升级、卸载与更多</summary>
          <h4>升级</h4>
          <div class="cmd"><code>sudo kiko upgrade</code><button type="button">复制</button></div>
          <p>配置与数据保留；新版本启动失败时自动换回旧版本。</p>
          <h4>卸载</h4>
          <div class="cmd"><code>sudo kiko uninstall</code><button type="button">复制</button></div>
          <p>数据保留在 <code class="inline">/var/lib/kiko-server</code>；加 <code class="inline">--purge</code> 一并删除。</p>
          <h4>安装指定版本</h4>
          <div class="cmd"><code>curl -fsSL {{.Latest}}/install-server.sh | sudo sh -s -- --version {{.Version}}</code><button type="button">复制</button></div>
          <h4>手动下载</h4>
          <p><a href="{{.ServerArchive "amd64"}}">x86_64 (.tar.gz)</a> · <a href="{{.ServerArchive "arm64"}}">ARM64 (.tar.gz)</a></p>
        </details>
      </div>
    </div>
  </div>
</section>

<section class="block" id="faq">
  <div class="wrap">
    <p class="kicker">常见问题</p>
    <h2>还有疑问？</h2>
    <div class="faq">
      <details>
        <summary>怎么升级？</summary>
        <p>桌面应用每天自动检查新版本，也可以从菜单「Kiko → 检查更新…」立即检查，确认后自动下载并重启。服务器运行 <code class="inline">sudo kiko upgrade</code>。</p>
      </details>
      <details>
        <summary>更新安全吗？</summary>
        <p>桌面应用只安装用发布密钥签名的更新；服务器安装包下载后会核对 SHA-256。</p>
      </details>
      <details>
        <summary>服务器怎么配置？</summary>
        <dl>
          <dt><code class="inline">kiko status</code> · <code class="inline">logs</code> · <code class="inline">version</code></dt>
          <dd>服务状态、实时日志与当前版本。</dd>
          <dt><code class="inline">/etc/default/kiko-server</code></dt>
          <dd>监听地址、远程访问端口（默认 TLS 9443）与数据目录，修改后执行 <code class="inline">sudo kiko restart</code>。安装时自定义端口：在 <code class="inline">sudo</code> 后加 <code class="inline">REMOTE_LISTEN=:19443</code>。</dd>
          <dt>防火墙</dt>
          <dd>放行远程访问端口，例如 <code class="inline">sudo ufw allow 9443/tcp</code>。</dd>
        </dl>
      </details>
      <details>
        <summary>为什么系统提示无法验证开发者？</summary>
        <p>Kiko 暂未使用 Apple 开发者证书和 Windows 代码签名。macOS 在「系统设置 → 隐私与安全性」点「仍要打开」；Windows 点「更多信息 → 仍要运行」。</p>
      </details>
    </div>
  </div>
</section>
</main>

<footer>
  <div class="wrap">
    <a class="brand" href="#">Kiko</a>
    <span>v{{.Version}}</span>
    <div class="links">
      <a href="{{.Releases}}">版本与更新记录</a>
      <a href="https://github.com/{{.Repo}}">GitHub</a>
    </div>
  </div>
</footer>

<script>
(function () {
  var p = ((navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || "").toLowerCase();
  var os = p.indexOf("win") === 0 ? "win" : p.indexOf("linux") === 0 ? "linux" : "mac";
  document.querySelectorAll("#cta [data-os]").forEach(function (a) { a.hidden = a.dataset.os !== os; });
  var card = document.querySelector('[data-card="' + os + '"]');
  if (card) card.classList.add("current");
  document.querySelectorAll(".cmd button").forEach(function (button) {
    button.addEventListener("click", function () {
      var text = button.previousElementSibling.textContent;
      navigator.clipboard.writeText(text).then(function () {
        button.textContent = "已复制";
        setTimeout(function () { button.textContent = "复制"; }, 1500);
      });
    });
  });
})();
</script>
</body>
</html>
{{define "apple"}}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.4 12.6c0-2.4 2-3.6 2.1-3.7-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.1 1-4 2.4-1.7 2.9-.4 7.3 1.2 9.7.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8 1.5 0 1.9.8 3.2.8 1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8-.1 0-2.5-1-2.5-3.8zM14 5.4c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.8-1 2.9 1.1.1 2.1-.6 2.8-1.4z"/></svg>{{end}}
{{define "windows"}}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 5.5 10.5 4.4v7.1H3zM11.5 4.3 21 3v8.5h-9.5zM3 12.5h7.5v7.1L3 18.5zM11.5 12.5H21V21l-9.5-1.3z"/></svg>{{end}}
{{define "server"}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/></svg>{{end}}
